# Local MySQL from XAMPP (create the transform_assessment database in phpMyAdmin first)
# Hostinger: use the database name, user and password from hPanel → Databases
DATABASE_URL="mysql://root:@127.0.0.1:3306/transform_assessment"
# Public address used in candidate invite links. Leave empty locally.
# APP_URL="https://screening.tfshrms.cloud"
AUTH_SECRET="replace-with-a-long-random-string"
# Claude scores a submitted test as a draft. Hire / No Hire stays with a person.
# ANTHROPIC_API_KEY="paste-the-key-from-console.anthropic.com"

# Invitation emails. Use a no-reply mailbox if you have one. Candidates are told
# not to reply to the sending address and to contact HR@TRANSFORMSOLUTION.NET.
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_USER="noreply@transformsolution.net"
# SMTP_PASS="the-mailbox-password"
# MAIL_FROM="Transform Solution <noreply@transformsolution.net>"

# Vercel / production — Neon, Vercel Postgres, or Supabase
# Add both values in Vercel → Project → Settings → Environment Variables
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# AUTH_SECRET="paste-a-long-random-string"
# ANTHROPIC_API_KEY="paste-the-key-from-console.anthropic.com"
