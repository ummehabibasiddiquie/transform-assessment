generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  evaluations HumanEvaluation[]
  interviews  Interview[]
  decisions   Decision[]
  audits      AuditEvent[]
}

model Candidate {
  id        String   @id @default(cuid())
  name      String
  email     String
  status    String   @default("INVITED")
  createdAt DateTime @default(now())

  invites   Invite[]
  attempts  Attempt[]
  decisions Decision[]
}

model Role {
  id       String @id @default(cuid())
  name     String
  purpose  String @db.Text
  status   String @default("ACTIVE")
  versions RoleVersion[]
}

model RoleVersion {
  id          String    @id @default(cuid())
  roleId      String
  version     Int
  status      String    @default("PUBLISHED")
  publishedAt DateTime?
  role        Role      @relation(fields: [roleId], references: [id])
  competencies Competency[]
  assessments  Assessment[]
}

model Competency {
  id            String @id @default(cuid())
  roleVersionId String
  name          String
  definition    String @db.Text
  weight        Float
  sortOrder     Int
  exceptional   String @db.Text
  acceptable    String @db.Text
  poor          String @db.Text
  roleVersion   RoleVersion @relation(fields: [roleVersionId], references: [id])
  evaluations   HumanEvaluation[]
}

model Assessment {
  id            String @id @default(cuid())
  roleVersionId String
  name          String
  durationMin   Int
  status        String @default("PUBLISHED")
  roleVersion   RoleVersion @relation(fields: [roleVersionId], references: [id])
  versions      AssessmentVersion[]
}

model AssessmentVersion {
  id           String    @id @default(cuid())
  assessmentId String
  version      Int
  status       String    @default("PUBLISHED")
  publishedAt  DateTime?
  instructions String @db.Text
  aiPolicy     String @db.Text
  criticalGates String   @default(dbgenerated("('')")) @db.Text
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  tasks        Task[]
  attempts     Attempt[]
  invites      Invite[]
}

model Task {
  id                  String @id @default(cuid())
  assessmentVersionId String
  sequence            Int
  family              String
  title               String @db.Text
  instructions        String @db.Text
  referenceMaterial   String @default(dbgenerated("('')")) @db.Text
  responseType        String
  timeLimitMin        Int?
  aiAllowed           Boolean @default(true)
  searchAllowed       Boolean @default(true)
  evidenceNotes       String  @default(dbgenerated("('')")) @db.Text
  module              String  @default("ROLE")
  optionsJson         String  @default(dbgenerated("('[]')")) @db.Text
  competencyName      String  @default("")
  sourceId            String  @default("")
  isGate              Boolean @default(false)
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id])
  responses           Response[]
  key                 TaskKey?
}

model Invite {
  id                  String   @id @default(cuid())
  candidateId         String
  assessmentVersionId String
  token               String   @unique
  createdAt           DateTime @default(now())
  candidate           Candidate @relation(fields: [candidateId], references: [id])
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id])
  attempts            Attempt[]
}

model Attempt {
  id                  String    @id @default(cuid())
  candidateId         String
  assessmentVersionId String
  inviteId            String?
  status              String    @default("IN_PROGRESS")
  currentTaskSequence Int       @default(1)
  startedAt           DateTime  @default(now())
  submittedAt         DateTime?
  overallScore        Float?
  recommendation      String?
  uncertainties       String    @default(dbgenerated("('')")) @db.Text
  candidate           Candidate @relation(fields: [candidateId], references: [id])
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id])
  invite              Invite?   @relation(fields: [inviteId], references: [id])
  responses           Response[]
  evaluations         HumanEvaluation[]
  interview           Interview?
  decisions           Decision[]
  suggestions         AiSuggestion[]
  gateReviews         GateReview[]
}

model Response {
  id              String   @id @default(cuid())
  attemptId       String
  taskId          String
  contentJson     String   @default(dbgenerated("('{}')")) @db.MediumText
  resourceLogJson String   @default(dbgenerated("('{}')")) @db.MediumText
  savedAt         DateTime @default(now())
  attempt         Attempt  @relation(fields: [attemptId], references: [id])
  task            Task     @relation(fields: [taskId], references: [id])

  @@unique([attemptId, taskId])
}

model HumanEvaluation {
  id           String   @id @default(cuid())
  attemptId    String
  competencyId String
  score        Float
  rationale    String   @default(dbgenerated("('')")) @db.Text
  evaluatorId  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  attempt      Attempt    @relation(fields: [attemptId], references: [id])
  competency   Competency @relation(fields: [competencyId], references: [id])
  evaluator    User       @relation(fields: [evaluatorId], references: [id])

  @@unique([attemptId, competencyId])
}

model Interview {
  id             String   @id @default(cuid())
  attemptId      String   @unique
  notes          String   @default(dbgenerated("('')")) @db.Text
  probesUsed     String   @default(dbgenerated("('')")) @db.Text
  interviewerId  String
  updatedAt      DateTime @updatedAt
  attempt        Attempt  @relation(fields: [attemptId], references: [id])
  interviewer    User     @relation(fields: [interviewerId], references: [id])
}

model Decision {
  id          String   @id @default(cuid())
  candidateId String
  attemptId   String
  outcome     String
  rationale   String @db.Text
  decidedById String
  createdAt   DateTime @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  attempt     Attempt   @relation(fields: [attemptId], references: [id])
  decidedBy   User      @relation(fields: [decidedById], references: [id])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  String   @default(dbgenerated("('{}')")) @db.Text
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
}

model LibraryImport {
  id             String   @id @default(cuid())
  libraryVersion String
  fileName       String
  importedAt     DateTime @default(now())
  summaryJson    String @db.MediumText
  importedById   String?
}

model LibraryRole {
  id               String @id @default(cuid())
  sourceId         String @unique
  name             String
  level            String
  experienceBand   String
  coreCapabilities String @db.Text
  profile          String @db.Text
  status           String @default("ACTIVE")
}

model LibraryCompetency {
  id         String @id @default(cuid())
  sourceId   String @unique
  name       String
  definition String @db.Text
  evidence   String @db.Text
  levelUse   String @db.Text
}

model LibraryAssessmentType {
  id        String @id @default(cuid())
  sourceId  String @unique
  name      String
  purpose   String @db.Text
  use       String @db.Text
  aiDefault String @db.Text
}

model LibraryContentItem {
  id              String @id @default(cuid())
  sourceId        String
  bank            String
  family          String @default("")
  title           String @default(dbgenerated("('')")) @db.Text
  candidateText   String @default(dbgenerated("('')")) @db.MediumText
  evaluatorKey    String @default(dbgenerated("('')")) @db.Text
  evidenceKey     String @default(dbgenerated("('')")) @db.Text
  competency      String @default("")
  difficulty      String @default("")
  aiPolicy        String @default(dbgenerated("('')")) @db.Text
  responseType    String @default("")
  equivalentGroup String @default("")
  status          String @default("ACTIVE")
  payloadJson     String @default(dbgenerated("('{}')")) @db.MediumText

  @@unique([bank, sourceId])
}

model LibraryBlueprint {
  id             String @id @default(cuid())
  sourceId       String @unique
  roleName       String
  level          String
  assessmentType String
  itemCount      String
  weight         String
  mandatory      String
  aiPolicy       String @db.Text
}

model LibraryConfig {
  id          String @id @default(cuid())
  kind        String
  sourceId    String
  title       String @default(dbgenerated("('')")) @db.Text
  payloadJson String @default(dbgenerated("('{}')")) @db.MediumText

  @@unique([kind, sourceId])
}

model TaskKey {
  id        String @id @default(cuid())
  taskId    String @unique
  answerKey String @default(dbgenerated("('')")) @db.Text
  rubric    String @default(dbgenerated("('')")) @db.Text
  evidence  String @default(dbgenerated("('')")) @db.Text
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model AssessmentTrack {
  id               String     @id @default(cuid())
  code             String     @unique
  roleName         String
  level            String
  experienceBand   String     @default("")
  parentProfile    String     @default(dbgenerated("('')")) @db.Text
  competencies     String     @default(dbgenerated("('')")) @db.Text
  assessmentTypes  String     @default(dbgenerated("('')")) @db.Text
  aiPolicy         String     @default(dbgenerated("('')")) @db.Text
  criticalGates    String     @default(dbgenerated("('')")) @db.Text
  status           String     @default("ACTIVE")
  items            BankItem[]
}

model BankItem {
  id              String           @id @default(cuid())
  sourceId        String           @unique
  module          String
  trackId         String?
  responseType    String
  title           String @db.Text
  prompt          String @db.Text
  optionsJson     String           @default(dbgenerated("('[]')")) @db.Text
  answerKey       String           @default(dbgenerated("('')")) @db.Text
  rubric          String           @default(dbgenerated("('')")) @db.Text
  evidence        String           @default(dbgenerated("('')")) @db.Text
  competency      String           @default("")
  difficulty      String           @default("")
  timeLimitMin    Int?
  aiAllowed       Boolean          @default(false)
  searchAllowed   Boolean          @default(false)
  equivalentGroup String           @default("")
  isGate          Boolean          @default(false)
  status          String           @default("APPROVED")
  bank            String           @default("")
  track           AssessmentTrack? @relation(fields: [trackId], references: [id], onDelete: SetNull)
}

model QuestionExposure {
  id        String   @id @default(cuid())
  email     String
  sourceId  String
  createdAt DateTime @default(now())

  @@unique([email, sourceId])
}

model AiSuggestion {
  id           String   @id @default(cuid())
  attemptId    String
  competencyId String
  score        Float
  rationale    String   @default(dbgenerated("('')")) @db.Text
  createdAt    DateTime @default(now())
  attempt      Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, competencyId])
}

model GateReview {
  id         String   @id @default(cuid())
  attemptId  String
  gate       String
  status     String
  note       String   @default(dbgenerated("('')")) @db.Text
  reviewerId String
  updatedAt  DateTime @updatedAt
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, gate])
}
